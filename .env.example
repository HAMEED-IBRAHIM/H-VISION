APP_ENV=development
APP_SECRET_KEY=super-secret-key-for-development-only-change-in-prod
POSTGRES_DB=janus_sentinel
POSTGRES_USER=janus
POSTGRES_PASSWORD=januspass
DATABASE_URL=postgresql+asyncpg://janus:januspass@postgres:5432/janus_sentinel
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
INTERNAL_SERVICE_TOKEN=internal-service-token-change-in-prod
ALLOWED_RED_TEAM_TARGETS=target_app
RED_TEAM_MAX_REQUESTS=200
RED_TEAM_REQUESTS_PER_SECOND=3
RED_TEAM_MAX_CONCURRENCY=2
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost,http://localhost:5173
